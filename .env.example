# Copy to .env for local use. Production must replace every value marked CHANGE_ME.
POSTGRES_DB=workmesh
POSTGRES_USER=workmesh
POSTGRES_PASSWORD=CHANGE_ME_unique_postgres_password
POSTGRES_PORT=5432
# Used by pnpm commands running on the host; keep it aligned with the three values above.
DATABASE_URL=postgres://workmesh:CHANGE_ME_unique_postgres_password@localhost:5432/workmesh

REDIS_URL=redis://redis:6379
MINIO_ROOT_USER=workmesh
MINIO_ROOT_PASSWORD=CHANGE_ME_unique_minio_password
MINIO_HOST_PORT=9000
S3_BUCKET=workmesh-artifacts
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=workmesh
S3_SECRET_ACCESS_KEY=CHANGE_ME_unique_minio_password
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_INTERNAL_ENDPOINT=http://minio:9000
S3_FORCE_PATH_STYLE=true
GITHUB_API_URL=https://api.github.com

SESSION_SECRET=CHANGE_ME_at_least_32_random_bytes
# 32-byte key encoded as 64 hex characters; encrypts versioned Agent webhook secrets.
WORKMESH_MASTER_KEY=CHANGE_ME_64_hex_characters
# Required only when running pnpm db:seed; use unique credentials (no defaults are provided).
SEED_ADMIN_EMAIL=CHANGE_ME_seed_admin_email
SEED_ADMIN_PASSWORD=CHANGE_ME_seed_admin_password_at_least_12_chars
SESSION_COOKIE_SECURE=false
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
API_HOST_PORT=3001
WEB_HOST_PORT=3000
MCP_HOST_PORT=3002
WORKMESH_MCP_MODE=read-write
# Protects the MCP HTTP transport itself; use a unique bearer secret.
WORKMESH_MCP_ACCESS_TOKEN=CHANGE_ME_unique_mcp_access_token
# Prefer a short-lived Session Token; leave empty until a Session is created.
WORKMESH_SESSION_TOKEN=
