# Copy to .env for local use. Production must replace every value marked CHANGE_ME.
POSTGRES_DB=workmesh
POSTGRES_USER=workmesh
POSTGRES_PASSWORD=CHANGE_ME_unique_postgres_password
POSTGRES_PORT=5432
# Used by pnpm commands running on the host; keep it aligned with the three values above.
DATABASE_URL=postgres://workmesh:CHANGE_ME_unique_postgres_password@localhost:5432/workmesh

REDIS_URL=redis://redis:6379
# Optional dedicated privacy key; defaults to SESSION_SECRET and must be at least 32 bytes when set.
AUTH_RATE_LIMIT_HMAC_KEY=
# Non-secret Redis key namespace; the default preserves production keys under {authrl}.
AUTH_RATE_LIMIT_REDIS_PREFIX=authrl
# Comma-separated proxy IP/CIDR allowlist. Empty means forwarded headers are ignored.
AUTH_RATE_LIMIT_TRUSTED_PROXY_CIDRS=
AUTH_RATE_LIMIT_ENDPOINT_BURST=30
AUTH_RATE_LIMIT_SOCKET_BURST=60
AUTH_RATE_LIMIT_CLIENT_IP_BURST=40
AUTH_RATE_LIMIT_SUBJECT_BURST=8
AUTH_RATE_LIMIT_INSTALL_BURST=5
AUTH_RATE_LIMIT_REFILL_MS=2000
AUTH_RATE_LIMIT_BACKOFF_BASE_MS=500
AUTH_RATE_LIMIT_BACKOFF_MAX_MS=60000
AUTH_RATE_LIMIT_REDIS_CONNECT_TIMEOUT_MS=500
AUTH_RATE_LIMIT_REDIS_COMMAND_TIMEOUT_MS=750
AUTH_RATE_LIMIT_SUMMARY_INTERVAL_MS=60000
MINIO_ROOT_USER=workmesh
MINIO_ROOT_PASSWORD=CHANGE_ME_unique_minio_password
MINIO_HOST_PORT=9000
S3_BUCKET=workmesh-artifacts
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=workmesh
S3_SECRET_ACCESS_KEY=CHANGE_ME_unique_minio_password
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_INTERNAL_ENDPOINT=http://minio:9000
S3_FORCE_PATH_STYLE=true
GITHUB_API_URL=https://api.github.com

SESSION_SECRET=CHANGE_ME_at_least_32_random_bytes
# Generate with `pnpm bootstrap:token`. This one-time deployment credential is
# sent only as X-WorkMesh-Bootstrap-Token during initial installation.
WORKMESH_BOOTSTRAP_TOKEN=CHANGE_ME_run_pnpm_bootstrap_token
# Development-only escape hatch. It is forbidden in production and is safe only
# with API_HOST set to literal 127.0.0.1 or ::1 and no trusted proxy CIDRs.
WORKMESH_BOOTSTRAP_ALLOW_LOOPBACK=false
API_HOST=0.0.0.0
# 32-byte key encoded as 64 hex characters; encrypts versioned Agent webhook secrets.
WORKMESH_MASTER_KEY=CHANGE_ME_64_hex_characters
# Required only when running pnpm db:seed; use unique credentials (no defaults are provided).
SEED_ADMIN_EMAIL=CHANGE_ME_seed_admin_email
SEED_ADMIN_PASSWORD=CHANGE_ME_seed_admin_password_at_least_12_chars
SESSION_COOKIE_SECURE=false
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
API_HOST_PORT=3001
WEB_HOST_PORT=3000
MCP_HOST_PORT=3002
WORKMESH_MCP_MODE=read-write
# Protects the MCP HTTP transport itself; use a unique bearer secret.
WORKMESH_MCP_ACCESS_TOKEN=CHANGE_ME_unique_mcp_access_token
# Prefer a short-lived Session Token; leave empty until a Session is created.
WORKMESH_SESSION_TOKEN=

# Safe release identifier returned by GET /api/v1/info. Do not put secrets here.
WORKMESH_BUILD_SHA=unknown

# Non-stable capabilities are deployment configuration, not authorization.
# Every flag defaults false and must be explicitly enabled in API and worker.
WORKMESH_BETA_PLANNING=false
WORKMESH_BETA_TEMPLATES=false
WORKMESH_BETA_COSTS=false
WORKMESH_BETA_GITEA=false
WORKMESH_BETA_OPERATIONS_UI=false
WORKMESH_EXPERIMENTAL_AUTOMATION=false
WORKMESH_EXPERIMENTAL_AGENT_LOOPS=false
WORKMESH_EXPERIMENTAL_A2A=false
WORKMESH_EXPERIMENTAL_EXTERNAL_WEBHOOKS=false
WORKMESH_EXPERIMENTAL_MULTI_RUNTIME=false
