function showDeveloperCaptcha(options) {
try {
var captcha = new TencentCaptcha('2019113749', function(res) {
if (res.ticket){
var xhr = new XMLHttpRequest();
xhr.open("GET", '/security/verify?ticket=' + res.ticket + '&randstr=' + res.randstr, true);
xhr.onreadystatechange = function () {
if (xhr.readyState === 4 && xhr.status === 200) {
const resData = JSON.parse(xhr.responseText)
if(resData.data.allow) {
options.success()
captcha.destroy()
} else {
captcha.refresh()
}
} else {
captcha.refresh()
}
};
xhr.send();
}
},
{
ready: function(){},
needFeedBack: true,
type: options.type
}
);
captcha.show();
} catch (error) {
console.error(error)
}
