postgres-1  | 	      membership_state='exact'
postgres-1  | 	      AND state IN ('verified','pruned')
postgres-1  | 	      AND object_version_id IS NOT NULL
postgres-1  | 	    )
postgres-1  | 	    OR (
postgres-1  | 	      membership_state='legacy_unindexed'
postgres-1  | 	      AND state IN ('uploaded','verified','pruned','failed')
