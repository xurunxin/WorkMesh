postgres-1  | 	       AND item.recipient_actor_id=NEW.actor_id
postgres-1  | 	       AND (
postgres-1  | 	         (
postgres-1  | 	           item.recipient_session_id IS NOT NULL
postgres-1  | 	           AND item.recipient_session_id=NEW.session_id
postgres-1  | 	         )
postgres-1  | 	         OR (
postgres-1  | 	           item.recipient_session_id IS NULL
postgres-1  | 	           AND item.claimed_by_session_id=NEW.session_id
postgres-1  | 	         )
postgres-1  | 	       )
postgres-1  | 	       AND (
postgres-1  | 	         NEW.kind<>'claimed'
postgres-1  | 	         OR (
postgres-1  | 	           item.recipient_session_id IS NULL
postgres-1  | 	           AND item.claimed_by_session_id=NEW.session_id
postgres-1  | 	         )
postgres-1  | 	       )
postgres-1  | 	  ) THEN
