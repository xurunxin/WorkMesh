postgres-1  | 	-- legacy:0022_route_policy_authorization_denials:begin
postgres-1  | 	-- Authorization denials are append-only security facts. They deliberately have
postgres-1  | 	-- no foreign keys to principals/resources so later deletion cannot erase the
postgres-1  | 	-- audit trail and so audit recording never discloses protected rows.
postgres-1  | 	CREATE TABLE authorization_denials (
postgres-1  | 	  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
postgres-1  | 	  occurred_at timestamptz NOT NULL DEFAULT now(),
postgres-1  | 	  correlation_id text NOT NULL,
postgres-1  | 	  policy_id text NOT NULL,
postgres-1  | 	  operation_id text NOT NULL,
postgres-1  | 	  transport text NOT NULL CHECK(transport IN ('rest','sse','mcp','sdk')),
postgres-1  | 	  principal_kind actor_kind,
postgres-1  | 	  principal_actor_id uuid,
postgres-1  | 	  principal_session_id uuid,
postgres-1  | 	  workspace_id uuid,
postgres-1  | 	  route_template text NOT NULL,
postgres-1  | 	  reason_code text NOT NULL,
postgres-1  | 	  authorization_stage text NOT NULL CHECK(authorization_stage IN (
postgres-1  | 	    'identity','session','delegation','capability','resource_scope',
postgres-1  | 	    'human_role','approval','lease','revision','idempotency','handler'
postgres-1  | 	  )),
postgres-1  | 	  resource_fingerprint text,
postgres-1  | 	  dedupe_key text,
postgres-1  | 	  CHECK(resource_fingerprint IS NULL OR resource_fingerprint ~ '^[0-9a-f]{64}$'),
postgres-1  | 	  CHECK(dedupe_key IS NULL OR dedupe_key ~ '^[0-9a-f]{64}$')
postgres-1  | 	);
postgres-1  | 	CREATE INDEX authorization_denials_workspace_time
postgres-1  | 	  ON authorization_denials(workspace_id,occurred_at DESC);
postgres-1  | 	CREATE INDEX authorization_denials_correlation
postgres-1  | 	  ON authorization_denials(correlation_id);
postgres-1  | 	CREATE INDEX authorization_denials_policy_reason
postgres-1  | 	  ON authorization_denials(policy_id,reason_code,occurred_at DESC);
postgres-1  | 	CREATE UNIQUE INDEX authorization_denials_dedupe
postgres-1  | 	  ON authorization_denials(dedupe_key)
postgres-1  | 	  WHERE dedupe_key IS NOT NULL;
postgres-1  | 	CREATE FUNCTION prevent_authorization_denial_mutation() RETURNS trigger LANGUAGE plpgsql AS $$
postgres-1  | 	BEGIN RAISE EXCEPTION 'IMMUTABLE_AUTHORIZATION_DENIAL'; END
postgres-1  | 	$$;
postgres-1  | 	CREATE TRIGGER authorization_denials_immutable
postgres-1  | 	  BEFORE UPDATE OR DELETE ON authorization_denials
postgres-1  | 	  FOR EACH ROW EXECUTE FUNCTION prevent_authorization_denial_mutation();
