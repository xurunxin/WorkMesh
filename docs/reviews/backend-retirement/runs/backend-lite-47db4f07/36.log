postgres-1  | 	UPDATE event_archive_segments
postgres-1  | 	   SET fixed_cutoff_at=date_trunc('milliseconds',fixed_cutoff_at),
postgres-1  | 	       metadata=jsonb_set(
postgres-1  | 	         metadata,
postgres-1  | 	         '{fixedCutoffAt}',
postgres-1  | 	         to_jsonb(
postgres-1  | 	           to_char(
postgres-1  | 	             date_trunc('milliseconds',fixed_cutoff_at) AT TIME ZONE 'UTC',
postgres-1  | 	             'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'
postgres-1  | 	           )
