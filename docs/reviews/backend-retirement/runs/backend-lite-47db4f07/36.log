postgres-1  | 	LANGUAGE plpgsql AS $$
postgres-1  | 	BEGIN
postgres-1  | 	  INSERT INTO event_retention_state(workspace_id)
postgres-1  | 	  VALUES(NEW.workspace_id)
postgres-1  | 	  ON CONFLICT(workspace_id) DO NOTHING;
postgres-1  | 	  PERFORM 1
postgres-1  | 	    FROM event_retention_state
postgres-1  | 	   WHERE workspace_id=NEW.workspace_id
postgres-1  | 	   FOR SHARE;
postgres-1  | 	  IF NEW.cursor IS NULL THEN
postgres-1  | 	    NEW.cursor := nextval(pg_get_serial_sequence('domain_events','cursor'));
postgres-1  | 	  END IF;
postgres-1  | 	  RETURN NEW;
postgres-1  | 	END;
