postgres-1  | 	    OR (
postgres-1  | 	      state='failed'
postgres-1  | 	      AND (
postgres-1  | 	        object_version_id IS NULL
postgres-1  | 	        OR (
postgres-1  | 	          object_version_id IS NOT NULL
postgres-1  | 	          AND length(btrim(object_version_id)) BETWEEN 1 AND 1024
postgres-1  | 	        )
