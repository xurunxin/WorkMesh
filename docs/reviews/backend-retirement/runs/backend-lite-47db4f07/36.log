postgres-1  | 	-- An external effect is durably moved to "prepared" before network I/O. If a
postgres-1  | 	-- worker crashes after the receiver accepted the request, reconciliation marks
postgres-1  | 	-- the unknown outcome without repeating a side effect that has no supported
postgres-1  | 	-- idempotency contract.
postgres-1  | 	CREATE TYPE automation_external_intent_state AS ENUM
postgres-1  | 	  ('prepared','acknowledged','uncertain');
postgres-1  | 	CREATE TABLE automation_external_effect_intents (
postgres-1  | 	  effect_id uuid PRIMARY KEY REFERENCES automation_effects(id) ON DELETE RESTRICT,
postgres-1  | 	  effect_key text NOT NULL UNIQUE,
postgres-1  | 	  request_hash text NOT NULL,
postgres-1  | 	  state automation_external_intent_state NOT NULL DEFAULT 'prepared',
postgres-1  | 	  response_status integer,
postgres-1  | 	  response_receipt text,
postgres-1  | 	  prepared_at timestamptz NOT NULL DEFAULT now(),
postgres-1  | 	  acknowledged_at timestamptz,
postgres-1  | 	  reconciled_at timestamptz,
postgres-1  | 	  CHECK((state='acknowledged')=(acknowledged_at IS NOT NULL)),
postgres-1  | 	  CHECK(state<>'uncertain' OR reconciled_at IS NOT NULL)
postgres-1  | 	);
