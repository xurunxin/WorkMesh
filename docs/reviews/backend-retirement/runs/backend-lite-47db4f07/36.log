postgres-1  | 	-- A floor row exists from Workspace birth, before any event transaction can
postgres-1  | 	-- race a pruner. The append trigger below therefore always locks a visible row.
postgres-1  | 	CREATE FUNCTION ensure_workspace_retention_state() RETURNS trigger
postgres-1  | 	LANGUAGE plpgsql AS $$
postgres-1  | 	BEGIN
postgres-1  | 	  INSERT INTO event_retention_state(workspace_id) VALUES(NEW.id)
postgres-1  | 	  ON CONFLICT(workspace_id) DO NOTHING;
postgres-1  | 	  RETURN NEW;
postgres-1  | 	END;
postgres-1  | 	$$;
postgres-1  | 	CREATE TRIGGER workspaces_create_retention_state
postgres-1  | 	  AFTER INSERT ON workspaces
postgres-1  | 	  FOR EACH ROW EXECUTE FUNCTION ensure_workspace_retention_state();
