postgres-1  | 	  IF NEW.recipient_human_actor_id IS NOT NULL AND recipient_kind <> 'human' THEN
postgres-1  | 	    RAISE EXCEPTION 'INBOX_HUMAN_RECIPIENT_REQUIRED';
postgres-1  | 	  END IF;
postgres-1  | 	  IF NEW.recipient_human_actor_id IS NULL AND recipient_kind <> 'agent' THEN
postgres-1  | 	    RAISE EXCEPTION 'INBOX_AGENT_RECIPIENT_REQUIRED';
postgres-1  | 	  END IF;
postgres-1  | 	  IF recipient_kind='agent' AND NEW.team_id IS NULL THEN
postgres-1  | 	    RAISE EXCEPTION 'INBOX_AGENT_TEAM_REQUIRED';
