postgres-1  | 	-- Non-room legacy producers carry their source Session. Use its persisted Team
postgres-1  | 	-- only when no room-derived Team was available.
postgres-1  | 	UPDATE inbox_items item
postgres-1  | 	   SET team_id=session.team_id
postgres-1  | 	  FROM agent_sessions session
postgres-1  | 	 WHERE item.workspace_id=session.workspace_id
postgres-1  | 	   AND item.session_id=session.id
