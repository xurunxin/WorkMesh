postgres-1  | 	-- Only backfill dependency audiences when the payload is corroborated by the
postgres-1  | 	-- durable edge. Deleted or otherwise unresolvable legacy edges remain
postgres-1  | 	-- fail-closed for non-admin humans in the final audience query.
postgres-1  | 	INSERT INTO domain_event_resources(
postgres-1  | 	  domain_event_id,
postgres-1  | 	  workspace_id,
postgres-1  | 	  relation,
postgres-1  | 	  resource_type,
postgres-1  | 	  resource_id
postgres-1  | 	)
postgres-1  | 	SELECT
postgres-1  | 	  event.id,
postgres-1  | 	  event.workspace_id,
postgres-1  | 	  relation.name,
postgres-1  | 	  resource.resource_type,
postgres-1  | 	  resource.resource_id
postgres-1  | 	FROM domain_events event
postgres-1  | 	JOIN projects source
postgres-1  | 	  ON source.id=event.aggregate_id
postgres-1  | 	 AND source.workspace_id=event.workspace_id
postgres-1  | 	JOIN project_dependencies dependency
postgres-1  | 	  ON dependency.project_id=source.id
postgres-1  | 	 AND dependency.depends_on_project_id=CASE
postgres-1  | 	       WHEN jsonb_typeof(event.payload->'dependsOnProjectId')='string'
postgres-1  | 	        AND event.payload->>'dependsOnProjectId'
postgres-1  | 	              ~ '^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$'
postgres-1  | 	       THEN (event.payload->>'dependsOnProjectId')::uuid
postgres-1  | 	       ELSE NULL
postgres-1  | 	     END
postgres-1  | 	JOIN projects target
postgres-1  | 	  ON target.id=dependency.depends_on_project_id
postgres-1  | 	 AND target.workspace_id=event.workspace_id
postgres-1  | 	CROSS JOIN (VALUES ('scope'),('invalidate')) relation(name)
postgres-1  | 	CROSS JOIN LATERAL (
postgres-1  | 	  VALUES
postgres-1  | 	    ('project',source.id),
postgres-1  | 	    ('team',source.team_id),
postgres-1  | 	    ('project',target.id),
postgres-1  | 	    ('team',target.team_id)
postgres-1  | 	) resource(resource_type,resource_id)
postgres-1  | 	WHERE event.event_type LIKE 'project.dependency.%'
postgres-1  | 	ON CONFLICT DO NOTHING;
