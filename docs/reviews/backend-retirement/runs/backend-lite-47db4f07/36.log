postgres-1  | 	-- legacy:0034_legacy_inbox_scope_derivation:begin
postgres-1  | 	-- Rolling deployments may keep pre-0032 Human Inbox producers alive after
postgres-1  | 	-- 0032 is applied. Derive the disclosure scope those producer shapes omit
postgres-1  | 	-- without changing the applied 0032 or 0033 migrations.
postgres-1  | 	CREATE OR REPLACE FUNCTION sync_legacy_inbox_recipient()
postgres-1  | 	RETURNS trigger
postgres-1  | 	LANGUAGE plpgsql
postgres-1  | 	AS $$
postgres-1  | 	DECLARE
postgres-1  | 	  derived_room_message_id uuid;
postgres-1  | 	  derived_room_team_id uuid;
postgres-1  | 	  derived_session_team_id uuid;
postgres-1  | 	BEGIN
postgres-1  | 	  IF NEW.recipient_human_actor_id IS NOT NULL THEN
postgres-1  | 	    NEW.recipient_actor_id := NEW.recipient_human_actor_id;
postgres-1  | 	  END IF;
postgres-1  |
postgres-1  | 	  IF NEW.source_room_message_id IS NOT NULL THEN
postgres-1  | 	    SELECT message.id,channel.team_id
postgres-1  | 	      INTO derived_room_message_id,derived_room_team_id
postgres-1  | 	      FROM room_messages message
postgres-1  | 	      JOIN work_room_channels channel
postgres-1  | 	        ON channel.id=message.channel_id
postgres-1  | 	       AND channel.workspace_id=message.workspace_id
postgres-1  | 	     WHERE message.workspace_id=NEW.workspace_id
postgres-1  | 	       AND message.id=NEW.source_room_message_id;
postgres-1  | 	  ELSIF NEW.source_type='room_message' THEN
postgres-1  | 	    SELECT message.id,channel.team_id
postgres-1  | 	      INTO derived_room_message_id,derived_room_team_id
postgres-1  | 	      FROM room_messages message
postgres-1  | 	      JOIN work_room_channels channel
postgres-1  | 	        ON channel.id=message.channel_id
postgres-1  | 	       AND channel.workspace_id=message.workspace_id
postgres-1  | 	     WHERE message.workspace_id=NEW.workspace_id
postgres-1  | 	       AND message.id=NEW.source_id;
postgres-1  | 	    IF derived_room_message_id IS NOT NULL THEN
postgres-1  | 	      NEW.source_room_message_id := derived_room_message_id;
postgres-1  | 	    END IF;
postgres-1  | 	  END IF;
postgres-1  |
postgres-1  | 	  IF NEW.team_id IS NULL THEN
postgres-1  | 	    NEW.team_id := derived_room_team_id;
postgres-1  | 	  END IF;
postgres-1  | 	  IF NEW.team_id IS NULL AND NEW.session_id IS NOT NULL THEN
postgres-1  | 	    SELECT session.team_id
postgres-1  | 	      INTO derived_session_team_id
postgres-1  | 	      FROM agent_sessions session
postgres-1  | 	     WHERE session.workspace_id=NEW.workspace_id
postgres-1  | 	       AND session.id=NEW.session_id;
postgres-1  | 	    NEW.team_id := derived_session_team_id;
postgres-1  | 	  END IF;
postgres-1  | 	  RETURN NEW;
postgres-1  | 	END $$;
