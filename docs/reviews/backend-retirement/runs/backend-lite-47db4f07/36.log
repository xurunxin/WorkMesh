postgres-1  |
postgres-1  | 	ALTER TABLE leases
postgres-1  | 	  ADD COLUMN heartbeat_idempotency_key text,
postgres-1  | 	  ADD COLUMN heartbeat_request_hash text,
postgres-1  | 	  ADD CONSTRAINT leases_heartbeat_idempotency_pair CHECK (
