postgres-1  | 	CREATE TABLE event_archive_segments (
postgres-1  | 	  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
postgres-1  | 	  workspace_id uuid NOT NULL REFERENCES workspaces(id) ON DELETE RESTRICT,
postgres-1  | 	  start_cursor bigint NOT NULL CHECK(start_cursor > 0),
postgres-1  | 	  end_cursor bigint NOT NULL CHECK(end_cursor >= start_cursor),
postgres-1  | 	  fixed_cutoff_at timestamptz NOT NULL,
postgres-1  | 	  row_count integer NOT NULL CHECK(row_count > 0),
postgres-1  | 	  object_key text NOT NULL,
postgres-1  | 	  object_version_id text NOT NULL
postgres-1  | 	    CHECK(length(btrim(object_version_id)) BETWEEN 1 AND 1024),
postgres-1  | 	  object_size_bytes bigint NOT NULL CHECK(object_size_bytes >= 0),
postgres-1  | 	  object_sha256 text NOT NULL CHECK(object_sha256 ~ '^sha256:[a-f0-9]{64}$'),
postgres-1  | 	  snapshot_digest text NOT NULL CHECK(snapshot_digest ~ '^sha256:[a-f0-9]{64}$'),
postgres-1  | 	  metadata jsonb NOT NULL DEFAULT '{}'::jsonb,
postgres-1  | 	  state event_archive_segment_state NOT NULL DEFAULT 'planned',
postgres-1  | 	  retain_until timestamptz NOT NULL,
postgres-1  | 	  uploaded_at timestamptz,
postgres-1  | 	  verified_at timestamptz,
postgres-1  | 	  pruned_at timestamptz,
postgres-1  | 	  last_error_code text,
postgres-1  | 	  created_at timestamptz NOT NULL DEFAULT now(),
postgres-1  | 	  updated_at timestamptz NOT NULL DEFAULT now(),
postgres-1  | 	  UNIQUE(workspace_id,start_cursor,end_cursor),
postgres-1  | 	  UNIQUE(object_key),
postgres-1  | 	  CHECK(retain_until >= created_at + interval '365 days'),
postgres-1  | 	  CHECK((state IN ('uploaded','verified','pruned')) = (uploaded_at IS NOT NULL)),
postgres-1  | 	  CHECK((state IN ('verified','pruned')) = (verified_at IS NOT NULL)),
postgres-1  | 	  CHECK((state='pruned') = (pruned_at IS NOT NULL))
postgres-1  | 	);
postgres-1  | 	CREATE INDEX event_archive_segments_status
postgres-1  | 	  ON event_archive_segments(workspace_id,state,fixed_cutoff_at,start_cursor);
postgres-1  | 	CREATE INDEX event_archive_segments_retention
postgres-1  | 	  ON event_archive_segments(retain_until)
postgres-1  | 	  WHERE state IN ('verified','pruned');
