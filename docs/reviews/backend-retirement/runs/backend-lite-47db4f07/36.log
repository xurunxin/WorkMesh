postgres-1  | 	  fence bigint NOT NULL DEFAULT 0 CHECK(fence >= 0),
postgres-1  | 	  fixed_cutoff_at timestamptz,
postgres-1  | 	  watermark_cursor bigint NOT NULL DEFAULT 0 CHECK(watermark_cursor >= 0),
postgres-1  | 	  last_error_code text,
