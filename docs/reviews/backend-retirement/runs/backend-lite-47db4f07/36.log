postgres-1  | 	CREATE FUNCTION enforce_two_level_initiative() RETURNS trigger LANGUAGE plpgsql AS $$
postgres-1  | 	BEGIN
postgres-1  | 	  IF NEW.parent_initiative_id IS NOT NULL AND EXISTS (
postgres-1  | 	    SELECT 1 FROM initiatives parent WHERE parent.id=NEW.parent_initiative_id AND parent.parent_initiative_id IS NOT NULL
postgres-1  | 	  ) THEN
postgres-1  | 	    RAISE EXCEPTION 'INITIATIVE_DEPTH_EXCEEDED';
postgres-1  | 	  END IF;
postgres-1  | 	  IF NEW.parent_initiative_id IS NOT NULL AND EXISTS (
postgres-1  | 	    SELECT 1 FROM initiatives child WHERE child.parent_initiative_id=NEW.id
postgres-1  | 	  ) THEN
postgres-1  | 	    RAISE EXCEPTION 'INITIATIVE_DEPTH_EXCEEDED';
postgres-1  | 	  END IF;
postgres-1  | 	  RETURN NEW;
postgres-1  | 	END
postgres-1  | 	$$;
postgres-1  | 	CREATE TRIGGER initiatives_two_levels BEFORE INSERT OR UPDATE OF parent_initiative_id
postgres-1  | 	  ON initiatives FOR EACH ROW EXECUTE FUNCTION enforce_two_level_initiative();
