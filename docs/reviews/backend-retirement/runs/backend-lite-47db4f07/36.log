postgres-1  | 	-- for the old anonymous CHECKs differ between PostgreSQL versions, so identify
postgres-1  | 	-- only checks that reference the replaced columns.
postgres-1  | 	DO $$
postgres-1  | 	DECLARE
postgres-1  | 	  constraint_row record;
postgres-1  | 	BEGIN
postgres-1  | 	  FOR constraint_row IN
postgres-1  | 	    SELECT conname
postgres-1  | 	      FROM pg_constraint
postgres-1  | 	     WHERE conrelid='event_archive_segments'::regclass
postgres-1  | 	       AND contype='c'
postgres-1  | 	       AND (
postgres-1  | 	         pg_get_constraintdef(oid) ILIKE '%object_version_id%'
postgres-1  | 	         OR pg_get_constraintdef(oid) ILIKE '%uploaded_at%'
postgres-1  | 	         OR pg_get_constraintdef(oid) ILIKE '%verified_at%'
postgres-1  | 	         OR pg_get_constraintdef(oid) ILIKE '%pruned_at%'
postgres-1  | 	         OR pg_get_constraintdef(oid) ILIKE '%membership_state%'
postgres-1  | 	       )
postgres-1  | 	  LOOP
postgres-1  | 	    EXECUTE format(
postgres-1  | 	      'ALTER TABLE event_archive_segments DROP CONSTRAINT %I',
postgres-1  | 	      constraint_row.conname
postgres-1  | 	    );
postgres-1  | 	  END LOOP;
postgres-1  | 	END;
postgres-1  | 	$$;
