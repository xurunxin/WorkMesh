postgres-1  | 	  JOIN work_room_channels channel
postgres-1  | 	    ON channel.id=message.channel_id
postgres-1  | 	   AND channel.workspace_id=message.workspace_id
postgres-1  | 	 WHERE item.workspace_id=message.workspace_id
postgres-1  | 	   AND item.source_type='room_message'
postgres-1  | 	   AND item.source_id=message.id
postgres-1  | 	   AND (
postgres-1  | 	     item.source_room_message_id IS NULL
postgres-1  | 	     OR item.team_id IS NULL
postgres-1  | 	   );
