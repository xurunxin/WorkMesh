postgres-1  | 	-- Heartbeat routes deliberately bypass the generic idempotency response store.
postgres-1  | 	-- Keep a fixed recent-key window per projection so K1/K2/retry-K1 cannot
postgres-1  | 	-- overwrite newer progress, while high-frequency pulses remain bounded.
postgres-1  | 	CREATE TABLE heartbeat_idempotency_keys (
postgres-1  | 	  resource_kind text NOT NULL CHECK(resource_kind IN ('session','lease')),
postgres-1  | 	  resource_id uuid NOT NULL,
postgres-1  | 	  idempotency_key text NOT NULL,
postgres-1  | 	  request_hash text NOT NULL CHECK(request_hash ~ '^(sha256:)?[a-f0-9]{64}$'),
postgres-1  | 	  observed_at timestamptz NOT NULL DEFAULT now(),
postgres-1  | 	  expires_at timestamptz NOT NULL,
postgres-1  | 	  PRIMARY KEY(resource_kind,resource_id,idempotency_key),
postgres-1  | 	  CHECK(expires_at >= observed_at)
postgres-1  | 	);
postgres-1  | 	CREATE INDEX heartbeat_idempotency_expiry
postgres-1  | 	  ON heartbeat_idempotency_keys(expires_at,resource_kind,resource_id);
postgres-1  |
postgres-1  | 	-- Ordinary command replay material is available for 24 hours. The key remains
postgres-1  | 	-- a conflict tombstone for 30 days. Existing rows receive a full deployment
postgres-1  | 	-- grace window so a rolling deploy cannot invalidate an in-flight retry.
postgres-1  | 	ALTER TABLE api_idempotency_keys
postgres-1  | 	  ADD COLUMN replay_expires_at timestamptz,
postgres-1  | 	  ADD COLUMN conflict_expires_at timestamptz;
postgres-1  | 	UPDATE api_idempotency_keys
postgres-1  | 	   SET replay_expires_at=GREATEST(created_at,now())+interval '24 hours',
postgres-1  | 	       conflict_expires_at=GREATEST(created_at,now())+interval '30 days';
postgres-1  | 	ALTER TABLE api_idempotency_keys
postgres-1  | 	  ALTER COLUMN replay_expires_at SET DEFAULT now()+interval '24 hours',
postgres-1  | 	  ALTER COLUMN replay_expires_at SET NOT NULL,
postgres-1  | 	  ALTER COLUMN conflict_expires_at SET DEFAULT now()+interval '30 days',
postgres-1  | 	  ALTER COLUMN conflict_expires_at SET NOT NULL,
postgres-1  | 	  ADD CONSTRAINT api_idempotency_expiry_order CHECK (
postgres-1  | 	    replay_expires_at >= created_at
postgres-1  | 	    AND conflict_expires_at >= replay_expires_at
postgres-1  | 	  );
postgres-1  | 	CREATE INDEX api_idempotency_replay_cleanup
postgres-1  | 	  ON api_idempotency_keys(replay_expires_at,workspace_id,actor_id,idempotency_key)
postgres-1  | 	  WHERE response_body IS NOT NULL;
postgres-1  | 	CREATE INDEX api_idempotency_conflict_cleanup
postgres-1  | 	  ON api_idempotency_keys(conflict_expires_at,workspace_id,actor_id,idempotency_key)
postgres-1  | 	  WHERE response_body IS NULL;
