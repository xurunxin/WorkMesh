{
  "name": "@workmesh/mcp",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/http.ts",
    "start": "node dist/http.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "tsx src/smoke.ts",
    "inspector": "npx @modelcontextprotocol/inspector tsx src/stdio.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@workmesh/agent-sdk": "workspace:*",
    "@workmesh/contracts": "workspace:*",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.2",
    "tsx": "^4.19.3",
    "vitest": "^3.1.3"
  }
}
