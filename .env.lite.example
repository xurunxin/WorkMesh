# Lite single-node deployment environment.
#
# Copy to `.env.lite` on the device and fill it in. The device has no checkout,
# no pnpm, and no registry, so this file plus the image tarball is the entire
# installation surface.
#
#   cp .env.lite.example .env.lite
#   docker compose --env-file .env.lite -f docker-compose.lite.yml config
#   docker compose --env-file .env.lite -f docker-compose.lite.yml up -d
#
# Every value marked CHANGE_ME must be replaced. The runtime guard rejects
# placeholder material, so a forgotten one stops the service with a clear error
# rather than starting insecurely.

# ---------------------------------------------------------------- image + build
# One tag, four roles. Built on a workstation, moved as a tarball, loaded here:
#   docker build -f infra/docker/lite.Dockerfile \
#     --build-arg WORKMESH_BUILD_SHA=$(git rev-parse HEAD) \
#     -t workmesh-lite:<sha> .
#   docker save workmesh-lite:<sha> | gzip > lite.tar.gz
#   docker load -i lite.tar.gz
WORKMESH_LITE_IMAGE=CHANGE_ME_workmesh-lite:exact_40_char_sha
# Must match the SHA the image was built from. The guard rejects anything that is
# not the exact lowercase 40-character Git SHA.
WORKMESH_BUILD_SHA=CHANGE_ME_exact_40_character_git_sha

# ------------------------------------------------------------------ networking
# 0.0.0.0 is the documented Lite default: a LAN deployment with no TLS. Set
# WORKMESH_BIND_ADDRESS=127.0.0.1 to publish nothing and put a reverse proxy in
# front instead. Never publish PostgreSQL or Redis; this compose does not.
WORKMESH_BIND_ADDRESS=0.0.0.0
WEB_HOST_PORT=3000
S3_HOST_PORT=9000
# The address the Browser uses. Use the LAN address, a hostname, or a tunnel name
# — anything the device is actually reachable at, because this value is what the
# session cookie and CORS are checked against.
WEB_ORIGIN=http://CHANGE_ME_lan_address:3000
# The Browser uploads straight to the object store with a presigned PUT, so the
# object store must be reachable from the LAN too. The filesystem artifact store
# removes this requirement.
S3_PUBLIC_ENDPOINT=http://CHANGE_ME_lan_address:9000
# Set to true when a reverse proxy terminates TLS for this deployment.
SESSION_COOKIE_SECURE=false

# ------------------------------------------------------------------ PostgreSQL
POSTGRES_DB=workmesh
POSTGRES_USER=workmesh
# At least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
POSTGRES_PASSWORD=CHANGE_ME_unique_postgres_password_at_least_32_characters

# ------------------------------------------------------------------------ Redis
# Redis carries a lossy wake hint stream and auth rate-limit token buckets. AOF is
# off in the compose; a restart therefore clears the token buckets, which opens a
# short brute-force window. Accepted for a single administrator on a LAN.
#
# The stream is the only thing that grows, so bounding it is how Redis stays
# small. Lowered from the 100000 default because one user's event volume does not
# need a longer wake history than this.
WORKMESH_REALTIME_REDIS_MAXLEN=10000

# ----------------------------------------------------------------- object store
MINIO_ROOT_USER=workmesh
MINIO_ROOT_PASSWORD=CHANGE_ME_unique_object_store_password_at_least_32_characters
S3_BUCKET=workmesh-artifacts
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=workmesh
S3_SECRET_ACCESS_KEY=CHANGE_ME_must_equal_MINIO_ROOT_PASSWORD
S3_FORCE_PATH_STYLE=true

# ------------------------------------------------------------- session + keys
# At least 32 characters, and must not reuse any other value in this file. The
# guard rejects exact reuse across named secrets.
SESSION_SECRET=CHANGE_ME_at_least_32_random_bytes
# 32 bytes encoded as exactly 64 hexadecimal characters. Encrypts versioned Agent
# webhook secrets.
WORKMESH_MASTER_KEY=CHANGE_ME_64_hex_characters
# One-time installation credential, sent as X-WorkMesh-Bootstrap-Token during
# initial setup. Generate with `pnpm bootstrap:token` on a workstation.
WORKMESH_BOOTSTRAP_TOKEN=CHANGE_ME_run_pnpm_bootstrap_token
# Versioned cursor signing ring: <kid>:<canonical base64url of at least 32 bytes>,
# comma-separated. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PAGINATION_CURSOR_KEYS=2026-01:CHANGE_ME_random_base64url_cursor_key
PAGINATION_CURSOR_ACTIVE_KID=2026-01
PAGINATION_CURSOR_TTL_SECONDS=900
# At least 32 characters, distinct from every other value here.
AUTH_RATE_LIMIT_HMAC_KEY=CHANGE_ME_unique_rate_limit_hmac_key
AUTH_RATE_LIMIT_REDIS_PREFIX=authrl
# Comma-separated proxy IP/CIDR allowlist. Empty means forwarded headers are
# ignored. Only set this when a trusted proxy actually sets them.
AUTH_RATE_LIMIT_TRUSTED_PROXY_CIDRS=

# ------------------------------------------------------------------- retention
# Archive-only. Deletion stays disabled in both directions, so a Lite device
# never removes its own history. The interval is relaxed from the 3600 s default
# so archive traffic does not compete with the UI on a slow disk.
WORKMESH_IDEMPOTENCY_REPLAY_HOURS=24
WORKMESH_IDEMPOTENCY_CONFLICT_DAYS=30
WORKMESH_EVENT_ONLINE_DAYS=90
WORKMESH_EVENT_ARCHIVE_RETAIN_DAYS=365
WORKMESH_RETENTION_CLEANUP_DAYS=30
WORKMESH_RETENTION_BATCH_SIZE=100
WORKMESH_RETENTION_LEASE_SECONDS=120
WORKMESH_RETENTION_INTERVAL_SECONDS=21600
WORKMESH_RETENTION_IO_TIMEOUT_SECONDS=300
WORKMESH_RETENTION_PROGRESS_STALE_SECONDS=7200
WORKMESH_RETENTION_ARCHIVE_PREFIX=retention/events

# ---------------------------------------------------------------- integrations
GITHUB_API_URL=https://api.github.com

# ---------------------------------------------------------------- feature flags
# Non-stable capabilities are deployment configuration, not authorization. Every
# flag defaults false and must be explicitly enabled.
WORKMESH_BETA_PLANNING=false
WORKMESH_BETA_TEMPLATES=false
WORKMESH_BETA_COSTS=false
WORKMESH_BETA_GITEA=false
WORKMESH_BETA_OPERATIONS_UI=false
WORKMESH_BETA_COORDINATION_MCP=false
# 只读目录：启用后可用本地完整 JSON 替换；空路径使用内置目录。
WORKMESH_BETA_MODEL_PRESETS=false
WORKMESH_MODEL_PRESETS_FILE=
WORKMESH_EXPERIMENTAL_AUTOMATION=false
WORKMESH_EXPERIMENTAL_AGENT_LOOPS=false
WORKMESH_EXPERIMENTAL_A2A=false
WORKMESH_EXPERIMENTAL_EXTERNAL_WEBHOOKS=false
WORKMESH_EXPERIMENTAL_MULTI_RUNTIME=false
