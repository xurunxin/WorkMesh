{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**"
      ],
      "env": [
        "RUN_INTEGRATION",
        "DATABASE_URL",
        "REDIS_URL",
        "SESSION_SECRET",
        "WORKMESH_BOOTSTRAP_TOKEN",
        "WORKMESH_MASTER_KEY",
        "WORKMESH_BUILD_SHA",
        "NEXT_PUBLIC_API_URL",
        "WORKMESH_PLAYWRIGHT_RUN_DIR",
        "PAGINATION_CURSOR_KEYS",
        "PAGINATION_CURSOR_ACTIVE_KID",
        "AUTH_RATE_LIMIT_HMAC_KEY",
        "AUTH_RATE_LIMIT_REDIS_PREFIX",
        "AUTH_RATE_LIMIT_TRUSTED_PROXY_CIDRS",
        "AUTH_RATE_LIMIT_ENDPOINT_BURST",
        "AUTH_RATE_LIMIT_SOCKET_BURST",
        "AUTH_RATE_LIMIT_CLIENT_IP_BURST",
        "AUTH_RATE_LIMIT_SUBJECT_BURST",
        "AUTH_RATE_LIMIT_INSTALL_BURST",
        "AUTH_RATE_LIMIT_REFILL_MS",
        "AUTH_RATE_LIMIT_BACKOFF_BASE_MS",
        "AUTH_RATE_LIMIT_BACKOFF_MAX_MS",
        "AUTH_RATE_LIMIT_REDIS_CONNECT_TIMEOUT_MS",
        "AUTH_RATE_LIMIT_REDIS_COMMAND_TIMEOUT_MS",
        "AUTH_RATE_LIMIT_SUMMARY_INTERVAL_MS"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "coverage/**"
      ],
      "env": [
        "RUN_INTEGRATION",
        "DATABASE_URL",
        "REDIS_URL",
        "SESSION_SECRET",
        "WORKMESH_BOOTSTRAP_TOKEN",
        "WORKMESH_MASTER_KEY",
        "WORKMESH_BUILD_SHA",
        "NEXT_PUBLIC_API_URL",
        "WORKMESH_PLAYWRIGHT_RUN_DIR",
        "PAGINATION_CURSOR_KEYS",
        "PAGINATION_CURSOR_ACTIVE_KID",
        "AUTH_RATE_LIMIT_HMAC_KEY",
        "AUTH_RATE_LIMIT_REDIS_PREFIX",
        "AUTH_RATE_LIMIT_TRUSTED_PROXY_CIDRS",
        "AUTH_RATE_LIMIT_ENDPOINT_BURST",
        "AUTH_RATE_LIMIT_SOCKET_BURST",
        "AUTH_RATE_LIMIT_CLIENT_IP_BURST",
        "AUTH_RATE_LIMIT_SUBJECT_BURST",
        "AUTH_RATE_LIMIT_INSTALL_BURST",
        "AUTH_RATE_LIMIT_REFILL_MS",
        "AUTH_RATE_LIMIT_BACKOFF_BASE_MS",
        "AUTH_RATE_LIMIT_BACKOFF_MAX_MS",
        "AUTH_RATE_LIMIT_REDIS_CONNECT_TIMEOUT_MS",
        "AUTH_RATE_LIMIT_REDIS_COMMAND_TIMEOUT_MS",
        "AUTH_RATE_LIMIT_SUMMARY_INTERVAL_MS"
      ]
    },
    "test:integration": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "env": [
        "RUN_INTEGRATION",
        "DATABASE_URL",
        "REDIS_URL",
        "SESSION_SECRET",
        "WORKMESH_BOOTSTRAP_TOKEN",
        "WORKMESH_MASTER_KEY",
        "WORKMESH_BUILD_SHA",
        "NEXT_PUBLIC_API_URL",
        "WORKMESH_PLAYWRIGHT_RUN_DIR",
        "PAGINATION_CURSOR_KEYS",
        "PAGINATION_CURSOR_ACTIVE_KID",
        "AUTH_RATE_LIMIT_HMAC_KEY",
        "AUTH_RATE_LIMIT_REDIS_PREFIX",
        "AUTH_RATE_LIMIT_TRUSTED_PROXY_CIDRS",
        "AUTH_RATE_LIMIT_ENDPOINT_BURST",
        "AUTH_RATE_LIMIT_SOCKET_BURST",
        "AUTH_RATE_LIMIT_CLIENT_IP_BURST",
        "AUTH_RATE_LIMIT_SUBJECT_BURST",
        "AUTH_RATE_LIMIT_INSTALL_BURST",
        "AUTH_RATE_LIMIT_REFILL_MS",
        "AUTH_RATE_LIMIT_BACKOFF_BASE_MS",
        "AUTH_RATE_LIMIT_BACKOFF_MAX_MS",
        "AUTH_RATE_LIMIT_REDIS_CONNECT_TIMEOUT_MS",
        "AUTH_RATE_LIMIT_REDIS_COMMAND_TIMEOUT_MS",
        "AUTH_RATE_LIMIT_SUMMARY_INTERVAL_MS"
      ]
    },
    "test:e2e": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "passThroughEnv": [
        "WORKMESH_E2E_EXTERNAL_WEB",
        "S3_ENDPOINT",
        "S3_BUCKET",
        "S3_ACCESS_KEY_ID",
        "S3_SECRET_ACCESS_KEY"
      ],
      "env": [
        "RUN_INTEGRATION",
        "DATABASE_URL",
        "REDIS_URL",
        "SESSION_SECRET",
        "WORKMESH_BOOTSTRAP_TOKEN",
        "WORKMESH_MASTER_KEY",
        "WORKMESH_BUILD_SHA",
        "NEXT_PUBLIC_API_URL",
        "WORKMESH_PLAYWRIGHT_RUN_DIR",
        "PAGINATION_CURSOR_KEYS",
        "PAGINATION_CURSOR_ACTIVE_KID",
        "AUTH_RATE_LIMIT_HMAC_KEY",
        "AUTH_RATE_LIMIT_REDIS_PREFIX",
        "AUTH_RATE_LIMIT_TRUSTED_PROXY_CIDRS",
        "AUTH_RATE_LIMIT_ENDPOINT_BURST",
        "AUTH_RATE_LIMIT_SOCKET_BURST",
        "AUTH_RATE_LIMIT_CLIENT_IP_BURST",
        "AUTH_RATE_LIMIT_SUBJECT_BURST",
        "AUTH_RATE_LIMIT_INSTALL_BURST",
        "AUTH_RATE_LIMIT_REFILL_MS",
        "AUTH_RATE_LIMIT_BACKOFF_BASE_MS",
        "AUTH_RATE_LIMIT_BACKOFF_MAX_MS",
        "AUTH_RATE_LIMIT_REDIS_CONNECT_TIMEOUT_MS",
        "AUTH_RATE_LIMIT_REDIS_COMMAND_TIMEOUT_MS",
        "AUTH_RATE_LIMIT_SUMMARY_INTERVAL_MS"
      ]
    },
    "@workmesh/db#test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "coverage/**"
      ],
      "env": [
        "RUN_INTEGRATION",
        "DATABASE_URL",
        "REDIS_URL",
        "SESSION_SECRET",
        "WORKMESH_BOOTSTRAP_TOKEN",
        "WORKMESH_MASTER_KEY",
        "WORKMESH_BUILD_SHA",
        "NEXT_PUBLIC_API_URL",
        "WORKMESH_PLAYWRIGHT_RUN_DIR",
        "PAGINATION_CURSOR_KEYS",
        "PAGINATION_CURSOR_ACTIVE_KID",
        "AUTH_RATE_LIMIT_HMAC_KEY",
        "AUTH_RATE_LIMIT_REDIS_PREFIX",
        "AUTH_RATE_LIMIT_TRUSTED_PROXY_CIDRS",
        "AUTH_RATE_LIMIT_ENDPOINT_BURST",
        "AUTH_RATE_LIMIT_SOCKET_BURST",
        "AUTH_RATE_LIMIT_CLIENT_IP_BURST",
        "AUTH_RATE_LIMIT_SUBJECT_BURST",
        "AUTH_RATE_LIMIT_INSTALL_BURST",
        "AUTH_RATE_LIMIT_REFILL_MS",
        "AUTH_RATE_LIMIT_BACKOFF_BASE_MS",
        "AUTH_RATE_LIMIT_BACKOFF_MAX_MS",
        "AUTH_RATE_LIMIT_REDIS_CONNECT_TIMEOUT_MS",
        "AUTH_RATE_LIMIT_REDIS_COMMAND_TIMEOUT_MS",
        "AUTH_RATE_LIMIT_SUMMARY_INTERVAL_MS"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/api/src/**",
        "$TURBO_ROOT$/apps/worker/src/**"
      ]
    },
    "@workmesh/contracts#test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "coverage/**"
      ],
      "env": [
        "RUN_INTEGRATION",
        "DATABASE_URL",
        "REDIS_URL",
        "SESSION_SECRET",
        "WORKMESH_BOOTSTRAP_TOKEN",
        "WORKMESH_MASTER_KEY",
        "WORKMESH_BUILD_SHA",
        "NEXT_PUBLIC_API_URL",
        "WORKMESH_PLAYWRIGHT_RUN_DIR",
        "PAGINATION_CURSOR_KEYS",
        "PAGINATION_CURSOR_ACTIVE_KID",
        "AUTH_RATE_LIMIT_HMAC_KEY",
        "AUTH_RATE_LIMIT_REDIS_PREFIX",
        "AUTH_RATE_LIMIT_TRUSTED_PROXY_CIDRS",
        "AUTH_RATE_LIMIT_ENDPOINT_BURST",
        "AUTH_RATE_LIMIT_SOCKET_BURST",
        "AUTH_RATE_LIMIT_CLIENT_IP_BURST",
        "AUTH_RATE_LIMIT_SUBJECT_BURST",
        "AUTH_RATE_LIMIT_INSTALL_BURST",
        "AUTH_RATE_LIMIT_REFILL_MS",
        "AUTH_RATE_LIMIT_BACKOFF_BASE_MS",
        "AUTH_RATE_LIMIT_BACKOFF_MAX_MS",
        "AUTH_RATE_LIMIT_REDIS_CONNECT_TIMEOUT_MS",
        "AUTH_RATE_LIMIT_REDIS_COMMAND_TIMEOUT_MS",
        "AUTH_RATE_LIMIT_SUMMARY_INTERVAL_MS"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/OPENAPI.yaml",
        "$TURBO_ROOT$/SCHEMA.sql",
        "$TURBO_ROOT$/AGENT_PROTOCOL.md",
        "$TURBO_ROOT$/README.md",
        "$TURBO_ROOT$/.env.example",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "$TURBO_ROOT$/.github/workflows/**",
        "$TURBO_ROOT$/packages/db/src/migration-manifest.ts",
        "$TURBO_ROOT$/docs/**",
        "$TURBO_ROOT$/scripts/**"
      ]
    },
    "@workmesh/api#typecheck": {
      "dependsOn": [
        "^typecheck"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/worker/src/**",
        "$TURBO_ROOT$/apps/mcp/src/**",
        "$TURBO_ROOT$/packages/*/src/**",
        "$TURBO_ROOT$/packages/*/package.json"
      ]
    },
    "@workmesh/web#typecheck": {
      "dependsOn": [
        "^typecheck"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/worker/src/**",
        "$TURBO_ROOT$/apps/fake-agent/src/**",
        "$TURBO_ROOT$/packages/*/src/**",
        "$TURBO_ROOT$/packages/*/package.json"
      ]
    }
  },
  "globalPassThroughEnv": [
    "RUN_INTEGRATION",
    "DATABASE_URL",
    "REDIS_URL",
    "SESSION_SECRET",
    "WORKMESH_BOOTSTRAP_TOKEN",
    "WORKMESH_MASTER_KEY",
    "WORKMESH_BUILD_SHA",
    "NEXT_PUBLIC_API_URL",
    "WORKMESH_PLAYWRIGHT_RUN_DIR",
    "PAGINATION_CURSOR_KEYS",
    "PAGINATION_CURSOR_ACTIVE_KID",
    "AUTH_RATE_LIMIT_HMAC_KEY",
    "AUTH_RATE_LIMIT_REDIS_PREFIX",
    "AUTH_RATE_LIMIT_TRUSTED_PROXY_CIDRS",
    "AUTH_RATE_LIMIT_ENDPOINT_BURST",
    "AUTH_RATE_LIMIT_SOCKET_BURST",
    "AUTH_RATE_LIMIT_CLIENT_IP_BURST",
    "AUTH_RATE_LIMIT_SUBJECT_BURST",
    "AUTH_RATE_LIMIT_INSTALL_BURST",
    "AUTH_RATE_LIMIT_REFILL_MS",
    "AUTH_RATE_LIMIT_BACKOFF_BASE_MS",
    "AUTH_RATE_LIMIT_BACKOFF_MAX_MS",
    "AUTH_RATE_LIMIT_REDIS_CONNECT_TIMEOUT_MS",
    "AUTH_RATE_LIMIT_REDIS_COMMAND_TIMEOUT_MS",
    "AUTH_RATE_LIMIT_SUMMARY_INTERVAL_MS"
  ],
  "globalDependencies": [
    "tsconfig*.json",
    "vitest*.ts",
    ".node-version",
    "scripts/ci-test-inputs.mjs",
    "scripts/**",
    "playwright*.ts"
  ]
}
