{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["RUN_INTEGRATION", "DATABASE_URL", "REDIS_URL", "SESSION_SECRET", "WORKMESH_MASTER_KEY", "AUTH_RATE_LIMIT_HMAC_KEY", "AUTH_RATE_LIMIT_TRUSTED_PROXY_CIDRS", "AUTH_RATE_LIMIT_ENDPOINT_BURST", "AUTH_RATE_LIMIT_SOCKET_BURST", "AUTH_RATE_LIMIT_CLIENT_IP_BURST", "AUTH_RATE_LIMIT_SUBJECT_BURST", "AUTH_RATE_LIMIT_INSTALL_BURST", "AUTH_RATE_LIMIT_REFILL_MS", "AUTH_RATE_LIMIT_BACKOFF_BASE_MS", "AUTH_RATE_LIMIT_BACKOFF_MAX_MS", "AUTH_RATE_LIMIT_REDIS_CONNECT_TIMEOUT_MS", "AUTH_RATE_LIMIT_REDIS_COMMAND_TIMEOUT_MS", "AUTH_RATE_LIMIT_SUMMARY_INTERVAL_MS"],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", ".next/**"] },
    "dev": { "cache": false, "persistent": true },
    "lint": { "dependsOn": ["^lint"] },
    "typecheck": { "dependsOn": ["^typecheck"] },
    "test": { "dependsOn": ["^build"], "outputs": ["coverage/**"] },
    "test:integration": { "dependsOn": ["^build"], "cache": false },
    "test:e2e": { "dependsOn": ["^build"], "cache": false }
  }
}
