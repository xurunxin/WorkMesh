docs/reviews/b1-b2/blueberry-recovery/ci*-artifacts/*/connector-source-*.json -text
docs/reviews/b1-b2/blueberry-recovery/ci*-artifacts/*/connector-cleanup.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
