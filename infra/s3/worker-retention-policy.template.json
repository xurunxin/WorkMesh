{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RetentionBucketInspection",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:GetBucketObjectLockConfiguration",
        "s3:ListBucket",
        "s3:ListBucketVersions"
      ],
      "Resource": "arn:aws:s3:::${S3_BUCKET}"
    },
    {
      "Sid": "RetentionArchiveObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:PutObject",
        "s3:PutObjectRetention"
      ],
      "Resource": "arn:aws:s3:::${S3_BUCKET}/${WORKMESH_RETENTION_ARCHIVE_PREFIX}/*"
    }
  ]
}
